{
  "name": "unity-asset-reader",
  "version": "0.0.0",
  "description": "Browser-first Unity AssetBundle reader: TypeScript parser, WASM only for leaf codecs",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./texture": {
      "types": "./dist/texture/index.d.ts",
      "import": "./dist/texture.mjs",
      "require": "./dist/texture.cjs"
    },
    "./node": {
      "types": "./dist/node/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "!dist/.tsbuildinfo*",
    "!dist/node/src/**",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "unity",
    "assetbundle",
    "unity-asset",
    "browser",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/texture2ddecoder-wasm.git",
    "directory": "unity-asset-reader"
  },
  "peerDependencies": {
    "texture2ddecoder-wasm": "^1.2.2"
  },
  "peerDependenciesMeta": {
    "texture2ddecoder-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.10.0",
    "rollup": "^4.30.1",
    "texture2ddecoder-wasm": "file:..",
    "tslib": "^2.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
