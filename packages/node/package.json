{
  "name": "unity-asset-reader-node",
  "version": "0.0.0",
  "description": "Node.js adapter for unity-asset-reader: file and directory loading with sidecar resolution.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test 'tests/**/*.test.ts'"
  },
  "keywords": [
    "unity",
    "assetbundle",
    "nodejs"
  ],
  "peerDependencies": {
    "unity-asset-reader": "^0.0.0"
  },
  "devDependencies": {
    "unity-asset-reader": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/texture2ddecoder-wasm.git",
    "directory": "packages/node"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
