# Recommended .gitignore entries for texture2ddecoder-wasm

# If you're copying WASM files to your public directory,
# you may want to ignore them in git since they're built artifacts
# that can be regenerated from node_modules

# Option 1: Ignore WASM files (recommended)
# The WASM files will be copied during build/install
public/wasm/
static/wasm/
src/assets/wasm/

# Option 2: Track WASM files for CDN deployment
# If you deploy public directory to CDN, you may want to track them
# In this case, don't add the above lines

# Common patterns for all projects
node_modules/
dist/
build/
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

