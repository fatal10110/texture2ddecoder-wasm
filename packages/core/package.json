{
  "name": "unity-asset-reader",
  "version": "0.0.0",
  "description": "Browser-first Unity AssetBundle parser: isomorphic, synchronous, zero platform dependencies.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "build": "rollup -c rollup.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check:browser": "node ../../scripts/check-browser.mjs core"
  },
  "keywords": [
    "unity",
    "assetbundle",
    "unity3d",
    "parser",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fatal10110/texture2ddecoder-wasm.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
